# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local source snapshots and working backups (keep the files on disk).
*.bak
*.bak.*
*.backup
*.backup.*
*.before
*.before.*
*.before-*
*.orig
*.old
/backups/

# Local OCR and book-proofreading materials; not required by the app runtime.
/book/
/docs/research/
/functions/lib/考察する若者たち_PDF照合報告.md
/functions/lib/考察する若者たち_全文_日本語修正版のコピー.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
